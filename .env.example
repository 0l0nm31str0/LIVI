# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Beluga Health API ───────────────────────────────────────────────────────
# Production: https://api.belugahealth.com/v1
# Sandbox:    https://sandbox-api.belugahealth.com/v1
BELUGA_API_URL=https://api.belugahealth.com/v1
BELUGA_API_KEY=your-beluga-bearer-token
BELUGA_WEBHOOK_SECRET=your-beluga-webhook-hmac-secret

# Prescriber defaults (used when creating Curexa orders)
PRESCRIBER_NPI=your-default-prescriber-npi
PRESCRIBER_ADDRESS=123 Medical Dr
PRESCRIBER_CITY=San Francisco
PRESCRIBER_STATE=CA
PRESCRIBER_ZIP=94105
PRESCRIBER_PHONE=4155550100

# ─── Curexa Pharmacy API ─────────────────────────────────────────────────────
# Base URL: https://api.curexa.com
CUREXA_API_URL=https://api.curexa.com
CUREXA_USERNAME=your-curexa-username
CUREXA_PASSWORD=your-curexa-password
CUREXA_WEBHOOK_SECRET=your-curexa-webhook-secret

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-random-32-char-string
