# ─── Supabase ────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com and run supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Beluga Health API ───────────────────────────────────────────────────────
# Staging:    https://api-staging.belugahealth.com
# Production: https://api.belugahealth.com
# API keys are NOT public — request staging/production keys from your Beluga rep.
BELUGA_API_URL=https://api-staging.belugahealth.com
BELUGA_API_KEY=your-beluga-bearer-token
BELUGA_WEBHOOK_SECRET=your-beluga-webhook-hmac-secret

# Partner-specific Beluga config (provided by Beluga during onboarding)
BELUGA_COMPANY=livi
BELUGA_PHARMACY_ID=your-curexa-pharmacy-id-in-beluga
BELUGA_VISIT_TYPE=weightloss
BELUGA_VISIT_ENDPOINT=/visit/createNoPay
BELUGA_CHAT_ENDPOINT=/external/receiveChat

# Default medication preference for visit intake (Beluga medId from your catalog)
BELUGA_DEFAULT_MED_ID=your-med-id
BELUGA_DEFAULT_MED_NAME=Patient preference pending
BELUGA_DEFAULT_MED_STRENGTH=N/A
BELUGA_DEFAULT_MED_QUANTITY=1
BELUGA_DEFAULT_MED_REFILLS=0
BELUGA_DEFAULT_MED_DAYS_SUPPLY=30

# Prescriber defaults (used when creating Curexa orders from RX_WRITTEN webhook)
PRESCRIBER_NPI=your-default-prescriber-npi

# ─── Curexa Pharmacy API ─────────────────────────────────────────────────────
# Base URL: https://api.curexa.com
# Credentials provided by Curexa DevOps — NOT public (returns 401 without auth).
CUREXA_API_URL=https://api.curexa.com
CUREXA_USERNAME=your-curexa-username
CUREXA_PASSWORD=your-curexa-password
CUREXA_WEBHOOK_SECRET=your-curexa-webhook-secret
CUREXA_SHIPPING_METHOD=usps_first
CUREXA_CARRIER=usps

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-random-32-char-string

# Webhook URLs to register with Beluga & Curexa:
#   {NEXT_PUBLIC_APP_URL}/api/webhooks/beluga
#   {NEXT_PUBLIC_APP_URL}/api/webhooks/curexa
